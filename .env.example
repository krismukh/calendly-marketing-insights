# Copy to .env and fill in. .env is ignored by git.

# Public spend data (no credentials required)
SPEND_BASE_URL=https://dea-data-bucket.s3.us-east-1.amazonaws.com/calendly_spend_data

# Filled in after Phase 2 (printed by infra/deploy_function.sh)
FUNCTION_URL=https://func-calendly-kcm.azurewebsites.net
FUNCTION_KEY=

# Filled in when the program shares the signing key with the webhook subscription
CALENDLY_SIGNING_KEY=
