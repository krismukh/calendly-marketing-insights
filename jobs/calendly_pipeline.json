{
  "name": "calendly_pipeline",
  "description": "Calendly Marketing Insights: rebuild Bronze, Silver, and Gold hourly on serverless compute (proposal Section 7; decision 28).",
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "/Users/krismukh@hotmail.com/01_bronze",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1200,
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    },
    {
      "task_key": "silver",
      "depends_on": [
        {
          "task_key": "bronze"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Users/krismukh@hotmail.com/02_silver",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1200,
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    },
    {
      "task_key": "gold",
      "depends_on": [
        {
          "task_key": "silver"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Users/krismukh@hotmail.com/03_gold",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 1200,
      "max_retries": 2,
      "min_retry_interval_millis": 300000
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 5 * * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "email_notifications": {
    "on_failure": [
      "krismukh@hotmail.com"
    ],
    "no_alert_for_skipped_runs": true
  },
  "tags": {
    "project": "calendly-marketing-insights",
    "owner": "kcm"
  }
}
